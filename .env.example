# Auto-injected by Vercel's AWS Databases integration once Aurora is provisioned
# (via the Vercel dashboard or v0.app marketplace flow) — do not set manually in
# production, but you need local equivalents to run scripts/dev against the
# same cluster.
PGHOST=
PGPORT=5432
PGUSER=
PGDATABASE=
AWS_REGION=us-east-1
# AWS_ROLE_ARN is runtime-injected by Vercel via OIDC in production. For local
# scripts, either run `aws sso login`/configure a profile with rds-db:connect +
# bedrock:InvokeModel permissions, or temporarily set PGPASSWORD to a manually
# generated RDS auth token (`aws rds generate-db-auth-token ...`).
PGPASSWORD=

# Bedrock
BEDROCK_REGION=us-east-1
BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0
BEDROCK_EMBED_MODEL_ID=amazon.titan-embed-text-v2:0

# Vercel Blob (image storage)
BLOB_READ_WRITE_TOKEN=
