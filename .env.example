# Auto-injected by Vercel's AWS Databases integration once Aurora is
# provisioned (Storage -> Amazon Aurora PostgreSQL). Pull the real values with:
#   vercel link && vercel env pull .env.local
AWS_ACCOUNT_ID=
AWS_REGION=us-east-1
AWS_RESOURCE_ARN=
AWS_ROLE_ARN=
PGDATABASE=
PGHOST=
PGPORT=5432
PGUSER=
PGSSLMODE=

# In production on Vercel, lib/db/pool.ts authenticates via Vercel's OIDC
# federation (awsCredentialsProvider + AWS_ROLE_ARN) -- no password needed here.
# Locally, that OIDC token isn't available, so generate a short-lived IAM auth
# token yourself and set it below (valid ~15 min, regenerate as needed):
#   aws rds generate-db-auth-token --hostname $PGHOST --port $PGPORT --username $PGUSER --region $AWS_REGION
PGPASSWORD=

# Bedrock
BEDROCK_REGION=us-east-1
BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-6
BEDROCK_EMBED_MODEL_ID=amazon.titan-embed-text-v2:0

# Vercel Blob (image storage)
BLOB_READ_WRITE_TOKEN=
